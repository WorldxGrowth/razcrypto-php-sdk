{
    "name": "worldxgrowth/razcrypto-php-sdk",
    "description": "Official PHP SDK for RazCrypto Gateway: payments, payment links, Standard Webhooks and checkout signature verification.",
    "type": "library",
    "license": "MIT",
    "keywords": ["razcrypto", "crypto", "payments", "gateway", "webhooks", "standard-webhooks"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-hash": "*"
    },
    "autoload": {
        "psr-4": {
            "RazCrypto\\": "src/"
        }
    },
    "scripts": {
        "test": ["php tests/vectors.php", "php tests/client.php"]
    },
    "config": {
        "sort-packages": true
    }
}
